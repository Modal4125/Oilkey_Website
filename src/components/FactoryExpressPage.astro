---
import { getRelativeLocaleUrl } from 'astro:i18n';
import PageHeader from './PageHeader.astro';
import Button from './Button.astro';
import { factoryExpress as copy } from '../i18n/factory-express';
import { factoryExpress as catalogueJa } from '../data/factory-express';
import { factoryExpressEn as catalogueEn } from '../data/factory-express-en';
import { oksDesignation, oksUrl } from '../data/oks-links';
import type { Lang } from '../i18n/home';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const catalogue = lang === 'ja' ? catalogueJa : catalogueEn;
const contactUrl = getRelativeLocaleUrl(lang, '/contact');
const downloadsUrl = getRelativeLocaleUrl(lang, '/catalogue');
const pdfUrl = `/downloads/factory-express-catalogue-${lang}.pdf`;
const xlsxUrl = `/downloads/factory-express-catalogue-${lang}.xlsx`;

// schema.org Product markup for every catalogue row, so search engines can
// index the product range. Deliberately no Offer/price data: the E-prices
// are carried from the legacy site and unconfirmed — add offers once
// pricing is verified.
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
// ja headers: 製 品 名 / 商 品 名 (spaced); en headers: exactly "Product"
// (anchored so "Item no." in the related-products table can't match).
const NAME_COL = /製\s*品\s*名|商\s*品\s*名|^product$/i;
const FEATURE_COL = /特\s*長|features/i;
const clean = (s: string) => s.replace(/\*\d+/g, '').replace(/\n/g, ' ').trim();

const products = catalogue.flatMap((cat) => {
  const nameIdx = cat.columns.findIndex((c) => NAME_COL.test(c));
  const featIdx = cat.columns.findIndex((c) => FEATURE_COL.test(c));
  if (nameIdx === -1) return [];
  return cat.rows
    .filter((row) => clean(row[nameIdx]) && clean(row[nameIdx]) !== '－')
    .map((row) => ({
      '@type': 'Product',
      name: clean(row[nameIdx]),
      ...(featIdx !== -1 && clean(row[featIdx]) ? { description: clean(row[featIdx]) } : {}),
      brand: {
        '@type': 'Brand',
        name: /^OKS/.test(row[nameIdx]) ? 'OKS' : 'F@ctory Express',
      },
      url: oksUrl(row[nameIdx]) ?? `${pageUrl}#${cat.id}`,
    }));
});

const productListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t.header.heading,
  numberOfItems: products.length,
  itemListElement: products.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item,
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(productListSchema)} />

<PageHeader eyebrow={t.header.eyebrow} heading={t.header.heading} intro={t.header.intro} />

<div class="wrap pt-10">
  {
    t.jaNotice && (
      <p class="border-line bg-panel text-steel mb-8 rounded-xs border px-5 py-4 text-sm">
        {t.jaNotice}
      </p>
    )
  }
  {/* Pill nav for narrow screens; lg+ gets the sticky sidebar below instead. */}
  <nav aria-label={t.categoriesLabel} class="flex flex-wrap gap-2 lg:hidden">
    {
      catalogue.map((cat) => (
        <a
          href={`#${cat.id}`}
          class="border-line bg-panel hover:border-amber hover:text-amber rounded-xs border px-4 py-2 text-[13px] font-medium transition-colors"
        >
          {cat.title}
        </a>
      ))
    }
  </nav>
  <div class="mt-6 flex flex-wrap gap-3">
    <a href={pdfUrl} download class="text-amber font-mono text-xs font-medium">
      {t.downloads.pdf}
    </a>
    <a href={xlsxUrl} download class="text-amber font-mono text-xs font-medium">
      {t.downloads.xlsx}
    </a>
  </div>
  <p class="text-steel-light mt-3 text-xs">{t.oksLinkNote}</p>
</div>

<div class="mx-auto flex w-full max-w-[1600px] gap-10 px-8">
  {/* Sticky category rail — rides alongside the tables down to the last one. */}
  <nav
    aria-label={t.categoriesLabel}
    class="sticky top-24 hidden h-fit max-h-[calc(100vh-8rem)] w-44 shrink-0 self-start overflow-y-auto pt-10 lg:block lg:pt-14"
  >
    <div class="text-steel mb-2.5 font-mono text-[11px] font-semibold tracking-[0.1em] uppercase">
      {t.categoriesLabel}
    </div>
    <ul class="border-line space-y-px border-l">
      {
        catalogue.map((cat, i) => (
          <li>
            <a
              href={`#${cat.id}`}
              data-cat-link={cat.id}
              class="hover:text-amber aria-[current=true]:border-amber aria-[current=true]:text-amber -ml-px flex items-baseline gap-2 border-l-2 border-transparent py-1.5 pl-3 text-[13px] leading-snug font-medium transition-colors aria-[current=true]:font-semibold"
            >
              <span class="text-steel-light font-mono text-[10px]">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span>{cat.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="min-w-0 flex-1">
    {
      catalogue.map((cat, i) => (
        <section id={cat.id} class="scroll-mt-24 py-10 lg:py-14">
          <div class="text-amber mb-3 flex items-baseline gap-3 font-mono text-xs font-semibold">
            <span>{String(i + 1).padStart(2, '0')}</span>
            <span>{cat.tag}</span>
          </div>
          <h2 class="mb-5 text-[22px] font-bold">
            {cat.title}
            <span class="text-steel ml-3 font-mono text-xs font-normal">
              {cat.rows.length}
              {t.countSuffix}
            </span>
          </h2>
          <div class="border-line max-h-[calc(100vh-140px)] overflow-auto rounded-xs border">
            {/* border-separate keeps the header's bottom border attached to the
              sticky <th>; with border-collapse the border belongs to the table
              and scrolls away underneath it. */}
            <table class="w-full min-w-[1080px] border-separate border-spacing-0 text-[13px]">
              <thead>
                <tr>
                  {cat.columns.map((col) => (
                    <th class="bg-panel border-line sticky top-0 z-10 border-b px-3.5 py-3 text-left align-bottom text-xs font-semibold whitespace-pre-line">
                      {col}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {cat.rows.map((row) => (
                  <tr class="even:bg-panel">
                    {row.map((cell, j) => {
                      const link = j === 0 ? oksUrl(cell) : undefined;
                      const name = link ? oksDesignation(cell)! : '';
                      const rest = link ? cell.slice(name.length) : '';
                      return (
                        <td
                          class:list={[
                            'border-line border-t px-3.5 py-3 align-top whitespace-pre-line',
                            j === 0 && 'text-ink min-w-[190px] font-medium',
                            j === 1 && 'text-steel min-w-[260px]',
                            j > 1 && 'text-steel min-w-[104px]',
                          ]}
                        >
                          {link ? (
                            <>
                              <a
                                href={link}
                                target="_blank"
                                rel="noopener"
                                class="text-blueprint hover:text-amber underline decoration-dotted underline-offset-2 transition-colors"
                              >
                                {name}
                              </a>
                              {rest}
                            </>
                          ) : (
                            cell
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {cat.notes.length > 0 && (
            <div class="mt-4">
              <div class="text-steel mb-1.5 font-mono text-[11px] font-semibold tracking-[0.1em] uppercase">
                {t.notesLabel}
              </div>
              <ul class="text-steel space-y-1 text-xs">
                {cat.notes.map((note) => (
                  <li>{note}</li>
                ))}
              </ul>
            </div>
          )}
        </section>
      ))
    }
  </div>
</div>

{/* Marks the category the reader is currently in on the sticky rail. */}
<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-cat-link]');
  const sections = [...links].map((link) => document.getElementById(link.dataset.catLink!));

  let queued = false;
  const sync = () => {
    queued = false;
    let active = 0;
    sections.forEach((section, i) => {
      if (section && section.getBoundingClientRect().top <= 140) active = i;
    });
    links.forEach((link, i) => link.setAttribute('aria-current', i === active ? 'true' : 'false'));
  };

  if (links.length) {
    sync();
    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(sync);
      },
      { passive: true },
    );
  }
</script>

<section class="pb-16 lg:pb-20">
  <div class="wrap">
    <div class="border-line bg-panel rounded-xs border px-[30px] py-10 text-center">
      <p class="text-steel text-sm">{t.note}</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3.5">
        <Button href={contactUrl} variant="primary">{t.contactCta}</Button>
        <Button href={downloadsUrl} variant="outline">{t.downloadsCta}</Button>
      </div>
    </div>
  </div>
</section>
